# Copy to bookish/.env (next to settings.py) or export these in your shell.
# Every variable is optional for local development.

# Django secret key (a fixed development key is used when unset)
SECRET_KEY=change-me
# Set to False in production
DEBUG=True

# Database connection string. Defaults to a local SQLite file (db.sqlite3).
# DATABASE_URL=postgres://user:password@localhost:5432/bookish

# Gmail SMTP. Leave EMAIL unset to print emails to the console instead.
EMAIL=your-address@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
